<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="addEventsLikesTableKushpit" author="Rostyslav Kushpit">
        <createTable tableName="event_likes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="liked_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint columnNames="event_id, user_id"
                             constraintName="uk_event_user_like"
                             tableName="event_likes"/>

        <addForeignKeyConstraint baseColumnNames="event_id"
                                 baseTableName="event_likes"
                                 referencedColumnNames="id"
                                 referencedTableName="events"
                                 onDelete="CASCADE"
                                 constraintName="fk_event_likes_event"/>

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="event_likes"
                                 referencedColumnNames="id"
                                 referencedTableName="users"
                                 onDelete="CASCADE"
                                 constraintName="fk_event_likes_user"/>

        <createIndex indexName="idx_event_likes_event" tableName="event_likes">
            <column name="event_id"/>
        </createIndex>

        <createIndex indexName="idx_event_likes_user" tableName="event_likes">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
