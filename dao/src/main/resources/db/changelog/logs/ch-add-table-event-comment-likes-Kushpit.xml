<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="addEventCommentLikesKushpit" author="Rostyslav Kushpit">
        <createTable tableName="event_comment_like">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="event_comment_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_event_comment_like_comment"
                             referencedTableName="event_comment" referencedColumnNames="id"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_event_comment_like_user"
                             referencedTableName="users" referencedColumnNames="id"/>
            </column>

            <column name="liked_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="event_comment_like"
                columnNames="event_comment_id, user_id"
                constraintName="uc_event_comment_like_unique_user_per_comment"/>

        <createIndex
                tableName="event_comment_like"
                indexName="idx_event_comment_like_comment">
            <column name="event_comment_id"/>
        </createIndex>

        <createIndex
                tableName="event_comment_like"
                indexName="idx_event_comment_like_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>